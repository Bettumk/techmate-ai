# TechMate AI Environment Configuration
# Copy this file to .env and adjust variables as needed

PORT=8000
HOST=0.0.0.0
SECRET_KEY=techmate-ai-secret-key-change-this-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./techmate.db

# Storage
UPLOAD_DIR=./uploads

# AI Service Settings
# Set GEMINI_API_KEY or OPENAI_API_KEY to connect to external LLMs.
# If left empty, TechMate uses its comprehensive built-in multi-agent intelligence engine.
AI_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
